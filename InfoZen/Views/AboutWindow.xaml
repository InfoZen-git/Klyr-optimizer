<Window x:Class="InfoZen.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="À propos – InfoZen"
        Width="380" Height="310"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Border Background="#1C1C1C" CornerRadius="10"
            BorderBrush="#2E2E2E" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="0" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Titlebar -->
            <Border Grid.Row="0" Background="#1C1C1C" CornerRadius="10,10,0,0"
                    MouseDown="TitleBar_MouseDown">
                <Grid Margin="16,0">
                    <TextBlock Text="À propos" FontSize="13" FontWeight="SemiBold"
                               Foreground="#E8E8E8" VerticalAlignment="Center"/>
                    <Button Content="✕" HorizontalAlignment="Right"
                            Width="28" Height="24" BorderThickness="0"
                            Background="Transparent" Foreground="#606060"
                            Cursor="Hand" Click="Close_Click" FontSize="12">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#C0392B"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Contenu -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center"
                        HorizontalAlignment="Center" Margin="32">

                <!-- Logo -->
                <Border Width="48" Height="48" CornerRadius="12"
                        Background="#4B8BF5" HorizontalAlignment="Center" Margin="0,0,0,14">
                    <TextBlock Text="IZ" FontSize="20" FontWeight="Bold"
                               Foreground="#FFFFFF"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="InfoZen" FontSize="20" FontWeight="SemiBold"
                           Foreground="#E8E8E8" HorizontalAlignment="Center"/>
                <TextBlock Text="Optimiseur PC Windows" FontSize="12" Foreground="#606060"
                           HorizontalAlignment="Center" Margin="0,3,0,20"/>

                <!-- Infos -->
                <Grid Width="280">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Version"
                               Foreground="#484848" FontSize="12" Margin="0,0,0,7"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="2.1.0"
                               Foreground="#E8E8E8" FontSize="12" FontWeight="Medium" Margin="0,0,0,7"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Développeur"
                               Foreground="#484848" FontSize="12" Margin="0,0,0,7"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Octave"
                               Foreground="#4B8BF5" FontSize="12" FontWeight="Medium" Margin="0,0,0,7"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Compatibilité"
                               Foreground="#484848" FontSize="12" Margin="0,0,0,7"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Windows 10 / 11 x64"
                               Foreground="#E8E8E8" FontSize="12" Margin="0,0,0,7"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Framework"
                               Foreground="#484848" FontSize="12"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text=".NET 10 + WPF"
                               Foreground="#E8E8E8" FontSize="12"/>
                </Grid>

            </StackPanel>
        </Grid>
    </Border>
</Window>
