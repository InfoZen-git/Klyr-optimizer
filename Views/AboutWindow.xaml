<Window x:Class="Klyr.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="À propos – Klyr"
        Width="420" Height="430"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Border Background="{DynamicResource BackgroundPanelBrush}" CornerRadius="10"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="0" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Titlebar -->
            <Border Grid.Row="0" Background="{DynamicResource BackgroundPanelBrush}" CornerRadius="10,10,0,0"
                    MouseDown="TitleBar_MouseDown">
                <Grid Margin="16,0">
                    <TextBlock Text="À propos" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <Button HorizontalAlignment="Right"
                            Width="32" Height="26" BorderThickness="0"
                            Background="Transparent" Foreground="{DynamicResource TextTertiaryBrush}"
                            Cursor="Hand" Click="Close_Click" ToolTip="Fermer">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                    <TextBlock Text="{StaticResource IconClose}"
                                               Style="{StaticResource IconWindowControlStyle}"
                                               Foreground="{TemplateBinding Foreground}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource ErrorBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Contenu -->
            <StackPanel Grid.Row="1" VerticalAlignment="Top"
                        HorizontalAlignment="Center" Margin="32,16,32,16">

                <!-- Logo -->
                <Image Source="pack://application:,,,/Assets/Icons/icon.ico"
                       Width="48" Height="48" HorizontalAlignment="Center" Margin="0,0,0,12"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <!-- Titre -->
                <TextBlock Text="Klyr" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Optimiseur PC Windows" FontSize="12"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Center" Margin="0,3,0,16"/>

                <!-- Infos -->
                <Grid Width="280" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Version"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,7"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="VersionText"
                               Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="Medium" Margin="0,0,0,7"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Développeur"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,7"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="InfoZen"
                               Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="Medium" Margin="0,0,0,7"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Compatibilité"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,7"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Windows 10 / 11 x64"
                               Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Margin="0,0,0,7"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Framework"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text=".NET 10 + WPF"
                               Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                </Grid>

                <!-- Outils diagnostic -->
                <TextBlock Text="DIAGNOSTIC" FontSize="10" FontWeight="Bold"
                           Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Click="CopySystemInfo_Click"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="30" FontSize="11" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{StaticResource IconCopy}" Style="{StaticResource IconButtonInlineStyle}"/>
                            <TextBlock Text="Copier infos système" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Click="ExportReport_Click"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="30" FontSize="11">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{StaticResource IconShare}" Style="{StaticResource IconButtonInlineStyle}"
                                       Foreground="{DynamicResource TextOnAccentBrush}"/>
                            <TextBlock Text="Exporter rapport" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

            </StackPanel>
        </Grid>
    </Border>
</Window>
