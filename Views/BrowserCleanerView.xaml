<UserControl x:Class="Klyr.Views.BrowserCleanerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Klyr.Resources">

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{x:Static loc:Strings.Browser_Title}" FontSize="20" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>

        <ScrollViewer Grid.Row="1">
            <StackPanel>
                <TextBlock Text="{x:Static loc:Strings.Browser_Warning}" FontSize="11"
                           Foreground="{DynamicResource WarningBrush}" Margin="2,0,2,10" TextWrapping="Wrap"/>
                <ItemsControl x:Name="BrowsersList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource BackgroundCardBrush}" CornerRadius="6"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    Padding="14,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding BrowserName}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox Content="{x:Static loc:Strings.Browser_Cache}" IsChecked="{Binding CleanCache, Mode=TwoWay}"
                                                  Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,20,0"/>
                                        <CheckBox Content="{x:Static loc:Strings.Browser_Cookies}" IsChecked="{Binding CleanCookies, Mode=TwoWay}"
                                                  Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,20,0"/>
                                        <CheckBox Content="{x:Static loc:Strings.Browser_History}" IsChecked="{Binding CleanHistory, Mode=TwoWay}"
                                                  Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="EmptyText" Text="{x:Static loc:Strings.Browser_NoBrowser}" FontSize="12"
                           Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center"
                           Margin="0,40,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="11"
                       Foreground="{DynamicResource TextTertiaryBrush}"/>
            <Button Content="{x:Static loc:Strings.Browser_CleanNow}" Click="Clean_Click"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Style="{StaticResource PrimaryButtonStyle}" Height="32" Width="160"/>
        </Grid>
    </Grid>
</UserControl>
