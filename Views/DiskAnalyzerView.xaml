<UserControl x:Class="Klyr.Views.DiskAnalyzerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Klyr.Resources">

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{x:Static loc:Strings.DiskAnalyzer_Title}" FontSize="20" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>

        <!-- Barre : lecteur + chemin + Lancer/Arrêter -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="↑" Click="Up_Click" ToolTip="{x:Static loc:Strings.DiskAnalyzer_Up}"
                    Style="{StaticResource SecondaryButtonStyle}" Width="36" Height="32" Margin="0,0,8,0"/>
            <ComboBox Grid.Column="1" x:Name="DriveCombo" Width="90" Height="32" Margin="0,0,8,0"
                      VerticalContentAlignment="Center"/>
            <Border Grid.Column="2" Background="{DynamicResource BackgroundCardBrush}" CornerRadius="6"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10,0" Margin="0,0,8,0">
                <TextBlock x:Name="PathText" VerticalAlignment="Center" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
            </Border>
            <Button Grid.Column="3" x:Name="StartButton" Content="{x:Static loc:Strings.DiskAnalyzer_Start}"
                    Click="Start_Click" Style="{StaticResource PrimaryButtonStyle}" Height="32" Width="110" Margin="0,0,8,0"/>
            <Button Grid.Column="4" x:Name="StopButton" Content="{x:Static loc:Strings.DiskAnalyzer_Stop}"
                    Click="Stop_Click" Style="{StaticResource SecondaryButtonStyle}" Height="32" Width="90"
                    IsEnabled="False"/>
        </Grid>

        <!-- Liste -->
        <ScrollViewer Grid.Row="2">
            <ItemsControl x:Name="EntriesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource BackgroundCardBrush}" CornerRadius="6"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                Padding="12,7" Margin="0,0,0,4" Cursor="Hand"
                                MouseLeftButtonUp="Entry_Click" Tag="{Binding}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12"
                                               Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding PercentStr}" FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="8,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SizeStr}" FontSize="11" FontWeight="Medium"
                                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Grid.Row="1" Height="4" Margin="0,5,0,0">
                                    <Border CornerRadius="2" Background="{DynamicResource BorderBrush}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding PercentOfParent, Converter={StaticResource PercentToStarConverter}}"/>
                                            <ColumnDefinition Width="{Binding PercentOfParent, Converter={StaticResource PercentToStarConverter}, ConverterParameter=rest}"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" CornerRadius="2" Background="{Binding BarColor}"/>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Overlay (état initial / scan) -->
        <Border Grid.Row="2" x:Name="OverlayPanel" Background="{DynamicResource BackgroundDeepBrush}" Visibility="Visible">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{StaticResource IconDiskAnalyzer}" FontFamily="{StaticResource FluentIconsFont}"
                           FontSize="28" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="OverlayText" Text="{x:Static loc:Strings.DiskAnalyzer_Idle}" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,0"
                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360"/>
            </StackPanel>
        </Border>

        <!-- Footer status -->
        <TextBlock Grid.Row="3" x:Name="StatusText" VerticalAlignment="Center" Margin="0,12,0,0" FontSize="11"
                   Foreground="{DynamicResource TextTertiaryBrush}"/>
    </Grid>
</UserControl>
