<UserControl x:Class="Klyr.Views.FileFinderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Klyr.Resources">

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{x:Static loc:Strings.Files_Title}" FontSize="20" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>

        <!-- Dossier + mode -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource BackgroundCardBrush}" CornerRadius="6"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10,6" Margin="0,0,8,0">
                <TextBlock x:Name="FolderText" Text="{x:Static loc:Strings.Files_NoFolder}" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </Border>
            <Button Grid.Column="1" Content="{x:Static loc:Strings.Files_ChooseFolder}" Click="ChooseFolder_Click"
                    Style="{StaticResource SecondaryButtonStyle}" Height="32" MinWidth="130"/>
        </Grid>

        <!-- Boutons mode + scan -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <RadioButton x:Name="ModeLarge" Content="{x:Static loc:Strings.Files_ModeLarge}" IsChecked="True"
                         Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <RadioButton x:Name="ModeDup" Content="{x:Static loc:Strings.Files_ModeDuplicates}"
                         Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,20,0"/>
            <Button x:Name="BtnStart" Content="{x:Static loc:Strings.Files_Start}" Click="Start_Click"
                    Style="{StaticResource PrimaryButtonStyle}" Height="32" MinWidth="110" Margin="0,0,8,0"/>
            <Button x:Name="BtnStop" Content="{x:Static loc:Strings.Files_Stop}" Click="Stop_Click"
                    Style="{StaticResource SecondaryButtonStyle}" Height="32" MinWidth="90" IsEnabled="False"/>
        </StackPanel>

        <ScrollViewer Grid.Row="3">
            <StackPanel>
                <ItemsControl x:Name="ResultsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource BackgroundCardBrush}" CornerRadius="6"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    Padding="12,7" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Medium"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Path}" FontSize="10"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding GroupLabel}" FontSize="9"
                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding SizeStr}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="EmptyText" Text="{x:Static loc:Strings.Files_Empty}" FontSize="12"
                           Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center"
                           Margin="0,40,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="StatusText" VerticalAlignment="Center" FontSize="11"
                       Foreground="{DynamicResource TextTertiaryBrush}"/>
            <Button Grid.Column="1" x:Name="BtnDelete" Content="{x:Static loc:Strings.Files_DeleteSelected}"
                    Click="Delete_Click" Style="{StaticResource SecondaryButtonStyle}" Height="32" MinWidth="200"/>
        </Grid>
    </Grid>
</UserControl>
