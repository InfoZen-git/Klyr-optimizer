<UserControl x:Class="Klyr.Views.HealthReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Klyr.Resources">

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.Health_Title}" FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="{x:Static loc:Strings.Health_Refresh}" Click="Refresh_Click"
                    Style="{StaticResource SecondaryButtonStyle}" Height="30" MinWidth="110"/>
        </Grid>

        <TextBlock Grid.Row="1" Text="{x:Static loc:Strings.Health_Subtitle}" FontSize="11"
                   Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <ScrollViewer Grid.Row="2">
            <ItemsControl x:Name="ChecksList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource BackgroundCardBrush}" CornerRadius="7"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                Padding="14,11" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="12" Height="12" VerticalAlignment="Center"
                                         Margin="0,0,12,0" Fill="{Binding SeverityColor}"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding Detail}" FontSize="11"
                                               Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="{x:Static loc:Strings.Health_Fix}"
                                        Style="{StaticResource SecondaryButtonStyle}" Height="30" MinWidth="100"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Command="{Binding DataContext.OpenToolCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding ActionPage}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2" x:Name="OverlayPanel" Background="{DynamicResource BackgroundDeepBrush}" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{StaticResource IconHealth}" FontFamily="{StaticResource FluentIconsFont}"
                           FontSize="28" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="{x:Static loc:Strings.Health_Loading}" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
