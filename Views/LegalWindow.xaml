<Window x:Class="Klyr.Views.LegalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mentions légales – Klyr"
        Width="520" Height="520"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Border Background="{DynamicResource BackgroundPanelBrush}" CornerRadius="10"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="0" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="54"/>
            </Grid.RowDefinitions>

            <!-- Titlebar -->
            <Border Grid.Row="0" Background="{DynamicResource BackgroundPanelBrush}" CornerRadius="10,10,0,0"
                    MouseDown="TitleBar_MouseDown">
                <Grid Margin="16,0">
                    <TextBlock Text="Mentions légales" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <Button HorizontalAlignment="Right"
                            Width="32" Height="26" BorderThickness="0"
                            Background="Transparent" Foreground="{DynamicResource TextTertiaryBrush}"
                            Cursor="Hand" Click="Close_Click" ToolTip="Fermer">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                    <TextBlock Text="{StaticResource IconClose}"
                                               Style="{StaticResource IconWindowControlStyle}"
                                               Foreground="{TemplateBinding Foreground}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource ErrorBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Contenu -->
            <ScrollViewer Grid.Row="1" Padding="20,16">
                <StackPanel>

                    <!-- RGPD -->
                    <Border Background="{DynamicResource StatusSuccessSubtleBgBrush}" CornerRadius="7" Padding="14,12"
                            BorderBrush="{DynamicResource StatusSuccessBorderBrush}" BorderThickness="1" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Confidentialité &amp; RGPD"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SuccessBrush}" Margin="0,0,0,6"/>
                            <TextBlock TextWrapping="Wrap" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="18">
Klyr fonctionne <Run FontWeight="Bold" Foreground="{DynamicResource TextEmphasizedBrush}">exclusivement en local</Run> sur votre ordinateur.
Aucune donnée personnelle n'est collectée ni envoyée.
Aucune connexion internet n'est établie (sauf test de vitesse réseau).
Les logs sont sauvegardés uniquement dans Documents\Klyr\Logs\
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Restauration -->
                    <Border Background="{DynamicResource StatusInfoSubtleBgBrush}" CornerRadius="7" Padding="14,12"
                            BorderBrush="{DynamicResource StatusInfoBorderBrush}" BorderThickness="1" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Garantie de Restauration"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>
                            <TextBlock TextWrapping="Wrap" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="18">
Klyr propose la création de <Run FontWeight="Bold" Foreground="{DynamicResource TextEmphasizedBrush}">points de restauration système</Run> avant chaque optimisation avancée, pour garantir la réversibilité des changements.
Activez l'option dans Paramètres → Point de restauration automatique.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Disclaimer -->
                    <Border Background="{DynamicResource StatusWarningSubtleBgBrush}" CornerRadius="7" Padding="14,12"
                            BorderBrush="{DynamicResource StatusWarningBorderBrush}" BorderThickness="1" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Clause de non-responsabilité"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,6"/>
                            <TextBlock TextWrapping="Wrap" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="18">
Klyr est fourni <Run FontWeight="Bold" Foreground="{DynamicResource TextEmphasizedBrush}">sans garantie</Run>. L'utilisateur est seul responsable de l'utilisation du logiciel.
Il est fortement recommandé de créer un point de restauration avant toute optimisation avancée et de sauvegarder ses données importantes.
Le développeur ne pourra être tenu responsable de tout dommage résultant de l'utilisation de ce logiciel.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Audit -->
                    <Border Background="{DynamicResource BackgroundCardBrush}" CornerRadius="7" Padding="14,12"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Journal des modifications (Audit)"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <TextBlock TextWrapping="Wrap" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="18">
Chaque action est consignée dans le terminal et exportable en .txt.
Chemin : <Run Foreground="{DynamicResource AccentBrush}">Documents\Klyr\Logs\Klyr_log_AAAAMMJJ.txt</Run>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Klyr v2.1 — Développé par InfoZen — Mars 2026"
                               FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Background="{DynamicResource BackgroundFooterBrush}" CornerRadius="0,0,10,10"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <Button Content="Fermer" Click="Close_Click"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="32" Width="120"/>
            </Border>
        </Grid>
    </Border>
</Window>
