<Window x:Class="InfoZen.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:InfoZen.ViewModels"
        Title="InfoZen"
        Width="1080" Height="700"
        MinWidth="880" MinHeight="580"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Border Background="{DynamicResource BackgroundDeepBrush}" CornerRadius="10"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="0" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="26"/>
            </Grid.RowDefinitions>

            <!-- ══════════════ TITLEBAR ══════════════ -->
            <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0"
                    Background="{DynamicResource BackgroundPanelBrush}" CornerRadius="10,10,0,0"
                    MouseDown="TitleBar_MouseDown">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logo -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/Icons/icon.ico"
                               Width="24" Height="24" Margin="0,0,9,0"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="InfoZen" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text=" 2.1" FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Page title -->
                    <TextBlock Grid.Column="1" Text="{Binding PageTitle}"
                               FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <!-- Window controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Width="28" Height="24" Margin="0,0,2,0"
                                Content="—" FontSize="11"
                                Background="Transparent" Foreground="{DynamicResource TextTertiaryBrush}"
                                BorderThickness="0" Cursor="Hand"
                                Click="Minimize_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                                            CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource BackgroundHoverBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextEmphasizedBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Width="28" Height="24" Margin="0,0,2,0"
                                Content="□" FontSize="12"
                                Background="Transparent" Foreground="{DynamicResource TextTertiaryBrush}"
                                BorderThickness="0" Cursor="Hand"
                                Click="Maximize_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                                            CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource BackgroundHoverBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextEmphasizedBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Width="28" Height="24"
                                Content="✕" FontSize="11"
                                Background="Transparent" Foreground="{DynamicResource TextTertiaryBrush}"
                                BorderThickness="0" Cursor="Hand"
                                Click="Close_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                                            CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource ErrorBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════════════ SIDEBAR ══════════════ -->
            <Border Grid.Column="0" Grid.Row="1" Grid.RowSpan="2"
                    Background="{DynamicResource BackgroundPanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,1,0">
                <DockPanel>

                    <StackPanel DockPanel.Dock="Top" Margin="10,14,10,0">

                        <!-- Section : Navigation -->
                        <TextBlock Text="NAVIGATION" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="12,0,0,6"/>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="Dashboard"
                                Style="{StaticResource NavButtonStyle}" Margin="0,1,0,1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⊞" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0"/>
                                <TextBlock Text="Tableau de bord" FontSize="12"/>
                            </StackPanel>
                        </Button>

                        <Separator Background="{DynamicResource BorderBrush}" Margin="12,10,12,10" Height="1"/>

                        <!-- Section : Modules -->
                        <TextBlock Text="MODULES" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="12,0,0,6"/>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="Gaming"
                                Style="{StaticResource NavButtonStyle}" Margin="0,1,0,1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎮" FontSize="13" Margin="0,0,10,0"/>
                                <StackPanel>
                                    <TextBlock Text="Gaming / FPS" FontSize="12"/>
                                    <TextBlock Text="9 optimisations" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="OldPC"
                                Style="{StaticResource NavButtonStyle}" Margin="0,1,0,1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💻" FontSize="13" Margin="0,0,10,0"/>
                                <StackPanel>
                                    <TextBlock Text="Vieux PC" FontSize="12"/>
                                    <TextBlock Text="8 optimisations" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="Cleaning"
                                Style="{StaticResource NavButtonStyle}" Margin="0,1,0,1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🧹" FontSize="13" Margin="0,0,10,0"/>
                                <StackPanel>
                                    <TextBlock Text="Nettoyage" FontSize="12"/>
                                    <TextBlock Text="8 optimisations" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="Network"
                                Style="{StaticResource NavButtonStyle}" Margin="0,1,0,1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🌐" FontSize="13" Margin="0,0,10,0"/>
                                <StackPanel>
                                    <TextBlock Text="Réseau" FontSize="12"/>
                                    <TextBlock Text="9 optimisations" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <Separator Background="{DynamicResource BorderBrush}" Margin="12,10,12,10" Height="1"/>

                        <!-- Section : Outils -->
                        <TextBlock Text="OUTILS" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="12,0,0,6"/>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="Terminal"
                                Style="{StaticResource NavButtonStyle}" Margin="0,1,0,1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&gt;_" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0"
                                           FontFamily="Consolas"/>
                                <TextBlock Text="Terminal" FontSize="12"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnSettings" Style="{StaticResource NavButtonStyle}"
                                Margin="0,1,0,1" Click="BtnSettings_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0"/>
                                <TextBlock Text="Paramètres" FontSize="12"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnLegal" Style="{StaticResource NavButtonStyle}"
                                Margin="0,1,0,1" Click="BtnLegal_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚖" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0"/>
                                <TextBlock Text="Mentions légales" FontSize="12"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnAbout" Style="{StaticResource NavButtonStyle}"
                                Margin="0,1,0,1" Click="BtnAbout_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ℹ" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0"/>
                                <TextBlock Text="À propos" FontSize="12"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>

                    <!-- Boutons bas de sidebar -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="10,0,10,12">
                        <Separator Background="{DynamicResource BorderBrush}" Margin="2,0,2,10" Height="1"/>

                        <Button Command="{Binding CreateRestorePointCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,0,5" Height="32" FontSize="11">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔒" FontSize="11" Margin="0,0,7,0"/>
                                <TextBlock Text="Point de restauration" FontSize="11"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ExportLogsCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Height="32" FontSize="11">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📄" FontSize="11" Margin="0,0,7,0"/>
                                <TextBlock Text="Exporter les logs" FontSize="11"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                </DockPanel>
            </Border>

            <!-- ══════════════ CONTENU PRINCIPAL ══════════════ -->
            <Grid Grid.Column="1" Grid.Row="1">

                <!-- ── DASHBOARD ── -->
                <ScrollViewer Padding="24,20"
                              Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Dashboard}">
                    <StackPanel>

                        <TextBlock Text="Tableau de bord" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,3"/>
                        <TextBlock Foreground="{DynamicResource TextTertiaryBrush}" FontSize="12" Margin="0,0,0,20">
                            <Run Text="{Binding SystemInfo.MachineName}"/>
                            <Run Text="  ·  "/>
                            <Run Text="Uptime : "/>
                            <Run Text="{Binding SystemInfo.Uptime}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </TextBlock>

                        <!-- Cartes stats (4 colonnes) -->
                        <UniformGrid Columns="4" Margin="0,0,0,16">

                            <!-- CPU -->
                            <Border Style="{StaticResource OptimizationCardStyle}" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="CPU" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding SystemInfo.CpuUsageStr}"
                                               FontSize="26" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="{Binding SystemInfo.CpuName}"
                                               FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}"
                                               TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                    <Border Height="3" CornerRadius="2"
                                            Background="{DynamicResource BorderBrush}" Margin="0,8,0,0">
                                        <Border Height="3" CornerRadius="2"
                                                Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left"
                                                Width="{Binding SystemInfo.CpuUsage, Converter={StaticResource PercentToWidthConverter}, ConverterParameter=140}"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- RAM -->
                            <Border Style="{StaticResource OptimizationCardStyle}" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="RAM" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding SystemInfo.RamPercentStr}"
                                               FontSize="26" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                    <TextBlock Text="{Binding SystemInfo.RamInfoStr}"
                                               FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,3,0,0"/>
                                    <Border Height="3" CornerRadius="2"
                                            Background="{DynamicResource BorderBrush}" Margin="0,8,0,0">
                                        <Border Height="3" CornerRadius="2"
                                                Background="{DynamicResource SuccessBrush}" HorizontalAlignment="Left"
                                                Width="{Binding SystemInfo.RamPercent, Converter={StaticResource PercentToWidthConverter}, ConverterParameter=140}"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Disque -->
                            <Border Style="{StaticResource OptimizationCardStyle}" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="DISQUE C:" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding SystemInfo.DiskFreeGb}"
                                                   FontSize="26" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/>
                                        <TextBlock Text=" Go" FontSize="14" Foreground="{DynamicResource WarningBrush}"
                                                   VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding SystemInfo.DiskInfoStr}"
                                               FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Optimisations -->
                            <Border Style="{StaticResource OptimizationCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="SESSION" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding OptimizationsRun}"
                                               FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="optimisations lancées"
                                               FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                        </UniformGrid>

                        <!-- Infos système + accès rapide -->
                        <Border Style="{StaticResource OptimizationCardStyle}" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="SYSTÈME" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding SystemInfo.OsName}"
                                               FontSize="12" Foreground="{DynamicResource TextEmphasizedBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Command="{Binding NavigateCommand}" CommandParameter="Gaming"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Content="Gaming" Margin="0,0,6,0" Height="30" FontSize="12"/>
                                    <Button Command="{Binding NavigateCommand}" CommandParameter="Cleaning"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Content="Nettoyage" Margin="0,0,6,0" Height="30" FontSize="12"/>
                                    <Button Command="{Binding NavigateCommand}" CommandParameter="Network"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Content="Réseau" Height="30" FontSize="12"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Activité récente -->
                        <TextBlock Text="ACTIVITÉ RÉCENTE" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <Border Background="{DynamicResource TerminalBgBrush}" CornerRadius="6" Height="130"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <TextBox Style="{StaticResource TerminalTextStyle}"
                                     Text="{Binding TerminalOutput, Mode=OneWay}"/>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- ── MODULES (Gaming / OldPC / Cleaning / Network) ── -->
                <Grid Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Module}"
                      Margin="24,20,24,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- En-tête -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock Text="{Binding PageTitle}" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,2"/>
                        <TextBlock Foreground="{DynamicResource TextTertiaryBrush}" FontSize="12">
                            <Run Text="{Binding CurrentOptimizations.Count, Mode=OneWay}"/>
                            <Run Text=" optimisations disponibles"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- Toolbar -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
                        <Button Command="{Binding RunAllOptimizationsCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Height="32" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▶ " FontSize="11"/>
                                <TextBlock Text="Tout exécuter" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding StopRunAllCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Height="32" Margin="0,0,8,0"
                                Visibility="{Binding IsRunAllInProgress, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="■ " FontSize="11"/>
                                <TextBlock Text="Arrêter" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <Border Background="{DynamicResource BackgroundCardBrush}" CornerRadius="5" Padding="10,0"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="En cours…" Foreground="{DynamicResource AccentBrush}"
                                       FontSize="12" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- Liste des optimisations -->
                    <ScrollViewer Grid.Row="2">
                        <ItemsControl ItemsSource="{Binding CurrentOptimizations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource OptimizationCardStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">

                                                <!-- Nom + badges -->
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,0"/>
                                                    <Border Background="{DynamicResource BadgeAdminBgBrush}" CornerRadius="3"
                                                            Padding="5,1" Margin="0,0,5,0"
                                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                            Visibility="{Binding RequiresAdmin, Converter={StaticResource AdminBadgeVisibilityConverter}}">
                                                        <TextBlock Text="Admin" FontSize="10" Foreground="{DynamicResource BadgeAdminTextBrush}"/>
                                                    </Border>
                                                    <Border Background="{DynamicResource BadgeRebootBgBrush}" CornerRadius="3"
                                                            Padding="5,1"
                                                            Margin="0,0,5,0"
                                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                            Visibility="{Binding RequiresReboot, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock Text="Reboot" FontSize="10" Foreground="{DynamicResource BadgeRebootTextBrush}"/>
                                                    </Border>
                                                    <Border Background="{Binding PurposeBadgeBackground}" CornerRadius="3"
                                                            Padding="5,1" Margin="0,0,5,0"
                                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                        <TextBlock Text="{Binding PurposeLabel}" FontSize="10" Foreground="{Binding PurposeBadgeForeground}"/>
                                                    </Border>
                                                    <Border Background="{Binding ConfidenceBadgeBackground}" CornerRadius="3"
                                                            Padding="5,1" Margin="0,0,5,0"
                                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                        <TextBlock Text="{Binding ConfidenceLabel}" FontSize="10" Foreground="{Binding ConfidenceBadgeForeground}"/>
                                                    </Border>
                                                    <Border Background="{DynamicResource BadgeAdvancedBgBrush}" CornerRadius="3"
                                                            Padding="5,1"
                                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                            Visibility="{Binding IsAdvanced, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock Text="Avancé" FontSize="10" Foreground="{DynamicResource BadgeAdvancedTextBrush}"/>
                                                    </Border>
                                                </StackPanel>

                                                <!-- Description -->
                                                <TextBlock Text="{Binding Description}"
                                                           FontSize="11" Foreground="{DynamicResource TextDescriptionBrush}"
                                                           TextWrapping="Wrap" Margin="0,0,0,5"/>

                                                <!-- Barre de progression -->
                                                <Grid Margin="0,4,0,0"
                                                      Visibility="{Binding ProgressVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="36"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Height="4" CornerRadius="2"
                                                            Background="{DynamicResource BackgroundHoverBrush}" VerticalAlignment="Center">
                                                        <Border Height="4" CornerRadius="2"
                                                                Background="{DynamicResource AccentBrush}"
                                                                HorizontalAlignment="Left"
                                                                Width="{Binding Progress, Converter={StaticResource PercentToWidthConverter}, ConverterParameter=200}"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding ProgressStr}"
                                                               FontSize="10" Foreground="{DynamicResource AccentBrush}"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"
                                                               Margin="4,0,0,0"/>
                                                </Grid>

                                                <!-- Statut -->
                                                <TextBlock FontSize="11" Margin="0,3,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Terminé">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Erreur">
                                                                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="En cours…">
                                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <Run Text="● "/>
                                                    <Run Text="{Binding Status, Mode=OneWay}"/>
                                                </TextBlock>

                                            </StackPanel>

                                            <!-- Bouton Exécuter -->
                                            <Button Grid.Column="1"
                                                    Command="{Binding DataContext.RunOptimizationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Height="32" Padding="14,0"
                                                    IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}"
                                                    VerticalAlignment="Center">
                                                <TextBlock FontSize="12">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Exécuter"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                    <Setter Property="Text" Value="En cours…"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Button>

                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                </Grid>

                <!-- ── TERMINAL ── -->
                <Grid Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Terminal}"
                      Margin="24,20,24,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Terminal" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,10,0"/>
                        <Border Background="{DynamicResource StatusLiveSuccessBgBrush}" CornerRadius="4" Padding="7,2"
                                BorderBrush="{DynamicResource StatusLiveSuccessBorderBrush}" BorderThickness="1"
                                VerticalAlignment="Center">
                            <TextBlock Text="LIVE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                        </Border>
                    </StackPanel>

                    <Border Grid.Row="1" Background="{DynamicResource TerminalBgBrush}" CornerRadius="6"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <TextBox Style="{StaticResource TerminalTextStyle}"
                                 Text="{Binding TerminalOutput, Mode=OneWay}"
                                 x:Name="TerminalTextBox"/>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,10">
                        <Button Command="{Binding ClearLogsCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="Effacer" Height="30" FontSize="12"
                                Margin="0,0,8,0"/>
                        <Button Command="{Binding ExportLogsCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Content="Exporter en .txt" Height="30" FontSize="12"/>
                    </StackPanel>

                </Grid>

            </Grid>

            <!-- ══════════════ STATUSBAR ══════════════ -->
            <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2"
                    Background="{DynamicResource BackgroundPanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,10,10">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding StatusMessage}"
                               Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1" Margin="0,0,14,0"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center">
                        <Run Text="CPU  "/>
                        <Run Text="{Binding CpuUsageStr, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}"/>
                    </TextBlock>

                    <TextBlock Grid.Column="2"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center">
                        <Run Text="RAM  "/>
                        <Run Text="{Binding SystemInfo.RamInfoStr, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </TextBlock>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
