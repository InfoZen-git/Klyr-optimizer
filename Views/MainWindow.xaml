<Window x:Class="Klyr.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:Klyr.ViewModels"
        xmlns:loc="clr-namespace:Klyr.Resources"
        xmlns:views="clr-namespace:Klyr.Views"
        Title="Klyr"
        Width="1080" Height="700"
        MinWidth="880" MinHeight="580"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">

    <!-- v2.2.0 — WindowChrome : 8 px de bordure pour grab/resize sur les 4 côtés et les coins.
         CaptionHeight=44 matches la titlebar custom → drag native + double-clic = maximize.
         Les boutons Min/Max/Close ont IsHitTestVisibleInChrome="True" pour rester cliquables. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            ResizeBorderThickness="8"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <!-- v2.2.0 — OuterBorder : coins arrondis + shadow quand normal,
         plat + sans shadow quand maximisé (géré dans MainWindow.xaml.cs OnStateChanged). -->
    <Border x:Name="OuterBorder"
            Background="{DynamicResource BackgroundDeepBrush}" CornerRadius="10"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="0" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="26"/>
            </Grid.RowDefinitions>

            <!-- ══════════════ TITLEBAR ══════════════ -->
            <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0"
                    Background="{DynamicResource BackgroundPanelBrush}" CornerRadius="10,10,0,0"
                    MouseDown="TitleBar_MouseDown">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logo -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/Icons/icon.ico"
                               Width="24" Height="24" Margin="0,0,9,0"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Klyr" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="VersionLabel" Text=" 2.3.0" FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Page title -->
                    <TextBlock Grid.Column="1" Text="{Binding PageTitle}"
                               FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <!-- v2.3.0 — Bouton "mise à jour disponible" (visible si update détecté) -->
                    <Button Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Command="{Binding OpenUpdateCommand}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Cursor="Hand" Height="24" Padding="10,0" Margin="0,0,10,0"
                            Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}"
                            ToolTip="{Binding UpdateLabel}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="ub" Background="{DynamicResource AccentSubtleBrush}" CornerRadius="12"
                                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="uIcon" Text="{StaticResource IconUpdate}" FontFamily="{StaticResource FluentIconsFont}"
                                                   FontSize="11" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="uText" Text="{Binding UpdateLabel}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ub" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                        <Setter TargetName="uIcon" Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
                                        <Setter TargetName="uText" Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Window controls (cliquables via WindowChrome) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Width="32" Height="26" Margin="0,0,2,0"
                                Background="Transparent" Foreground="{DynamicResource TextTertiaryBrush}"
                                BorderThickness="0" Cursor="Hand"
                                Click="Minimize_Click" ToolTip="{x:Static loc:Strings.Tooltip_Minimize}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                        <TextBlock Text="{StaticResource IconMinimize}"
                                                   Style="{StaticResource IconWindowControlStyle}"
                                                   Foreground="{TemplateBinding Foreground}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource BackgroundHoverBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextEmphasizedBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Width="32" Height="26" Margin="0,0,2,0"
                                Background="Transparent" Foreground="{DynamicResource TextTertiaryBrush}"
                                BorderThickness="0" Cursor="Hand"
                                Click="Maximize_Click" ToolTip="{x:Static loc:Strings.Tooltip_Maximize}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                        <TextBlock Text="{StaticResource IconMaximize}"
                                                   Style="{StaticResource IconWindowControlStyle}"
                                                   Foreground="{TemplateBinding Foreground}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource BackgroundHoverBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextEmphasizedBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Width="32" Height="26"
                                Background="Transparent" Foreground="{DynamicResource TextTertiaryBrush}"
                                BorderThickness="0" Cursor="Hand"
                                Click="Close_Click" ToolTip="{x:Static loc:Strings.Tooltip_Close}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                        <TextBlock Text="{StaticResource IconClose}"
                                                   Style="{StaticResource IconWindowControlStyle}"
                                                   Foreground="{TemplateBinding Foreground}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource ErrorBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════════════ SIDEBAR ══════════════ -->
            <!-- FIX : Row=1 seulement (plus de RowSpan=2). Avant, la barre latérale
                 descendait derrière la barre de statut full-width, qui masquait le
                 bouton « Exporter les logs ». -->
            <Border Grid.Column="0" Grid.Row="1"
                    Background="{DynamicResource BackgroundPanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- v2.3.0 — Nav scrollable (16 entrées possibles) -->
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,14,10,0">

                        <!-- Section : Navigation -->
                        <TextBlock Text="{x:Static loc:Strings.Dashboard_NavTitle}" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="12,0,0,6"/>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="Dashboard"
                                Style="{StaticResource NavButtonStyle}" Margin="0,1,0,1"
                                Background="{Binding CurrentPage, Converter={StaticResource NavActiveBgConverter}, ConverterParameter=Dashboard}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource IconDashboard}" Style="{StaticResource IconNavStyle}"/>
                                <TextBlock Text="{x:Static loc:Strings.PageTitle_Dashboard}" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Separator Background="{DynamicResource BorderBrush}" Margin="12,10,12,10" Height="1"/>

                        <!-- Section : Modules -->
                        <TextBlock Text="{x:Static loc:Strings.Nav_Modules}" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="12,0,0,6"/>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="Gaming"
                                Style="{StaticResource NavButtonStyle}" Margin="0,1,0,1"
                                Background="{Binding CurrentPage, Converter={StaticResource NavActiveBgConverter}, ConverterParameter=Gaming}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource IconGaming}" Style="{StaticResource IconNavStyle}"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{x:Static loc:Strings.Nav_NavigateGaming}" FontSize="12"/>
                                    <TextBlock FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                               Text="{Binding GamingCountText}"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="OldPC"
                                Style="{StaticResource NavButtonStyle}" Margin="0,1,0,1"
                                Background="{Binding CurrentPage, Converter={StaticResource NavActiveBgConverter}, ConverterParameter=OldPC}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource IconOldPC}" Style="{StaticResource IconNavStyle}"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{x:Static loc:Strings.Nav_NavigateOldPC}" FontSize="12"/>
                                    <TextBlock FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                               Text="{Binding OldPCCountText}"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="Cleaning"
                                Style="{StaticResource NavButtonStyle}" Margin="0,1,0,1"
                                Background="{Binding CurrentPage, Converter={StaticResource NavActiveBgConverter}, ConverterParameter=Cleaning}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource IconCleaning}" Style="{StaticResource IconNavStyle}"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{x:Static loc:Strings.Nav_NavigateCleaning}" FontSize="12"/>
                                    <TextBlock FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                               Text="{Binding CleaningCountText}"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="Network"
                                Style="{StaticResource NavButtonStyle}" Margin="0,1,0,1"
                                Background="{Binding CurrentPage, Converter={StaticResource NavActiveBgConverter}, ConverterParameter=Network}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource IconNetwork}" Style="{StaticResource IconNavStyle}"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{x:Static loc:Strings.Nav_NavigateNetwork}" FontSize="12"/>
                                    <TextBlock FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                               Text="{Binding NetworkCountText}"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="Streaming"
                                Style="{StaticResource NavButtonStyle}" Margin="0,1,0,1"
                                Background="{Binding CurrentPage, Converter={StaticResource NavActiveBgConverter}, ConverterParameter=Streaming}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource IconStreaming}" Style="{StaticResource IconNavStyle}"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{x:Static loc:Strings.Nav_NavigateStreaming}" FontSize="12"/>
                                    <TextBlock FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                               Text="{Binding StreamingCountText}"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="Privacy"
                                Style="{StaticResource NavButtonStyle}" Margin="0,1,0,1"
                                Background="{Binding CurrentPage, Converter={StaticResource NavActiveBgConverter}, ConverterParameter=Privacy}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource IconShield}" Style="{StaticResource IconNavStyle}"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{x:Static loc:Strings.Nav_NavigatePrivacy}" FontSize="12"/>
                                    <TextBlock FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                               Text="{Binding PrivacyCountText}"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <Separator Background="{DynamicResource BorderBrush}" Margin="12,10,12,10" Height="1"/>

                        <!-- Section : Outils -->
                        <TextBlock Text="{x:Static loc:Strings.Nav_Tools}" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="12,0,0,6"/>

                        <Button Command="{Binding OpenToolCommand}" CommandParameter="Health"
                                Style="{StaticResource NavButtonStyle}" Margin="0,1,0,1"
                                Background="{Binding CurrentPage, Converter={StaticResource NavActiveBgConverter}, ConverterParameter=Health}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource IconHealth}" Style="{StaticResource IconNavStyle}"/>
                                <TextBlock Text="{x:Static loc:Strings.Nav_Health}" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding OpenToolCommand}" CommandParameter="Profiles"
                                Style="{StaticResource NavButtonStyle}" Margin="0,1,0,1"
                                Background="{Binding CurrentPage, Converter={StaticResource NavActiveBgConverter}, ConverterParameter=Profiles}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource IconProfiles}" Style="{StaticResource IconNavStyle}"/>
                                <TextBlock Text="{x:Static loc:Strings.Nav_Profiles}" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="Terminal"
                                Style="{StaticResource NavButtonStyle}" Margin="0,1,0,1"
                                Background="{Binding CurrentPage, Converter={StaticResource NavActiveBgConverter}, ConverterParameter=Terminal}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource IconTerminal}" Style="{StaticResource IconNavStyle}"/>
                                <TextBlock Text="{x:Static loc:Strings.Nav_NavigateTerminal}" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- v2.3.0 — Outils avancés (fenêtres) -->
                        <Button Command="{Binding OpenToolCommand}" CommandParameter="Uninstaller"
                                Style="{StaticResource NavButtonStyle}" Margin="0,1,0,1"
                                Background="{Binding CurrentPage, Converter={StaticResource NavActiveBgConverter}, ConverterParameter=Uninstaller}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource IconUninstall}" Style="{StaticResource IconNavStyle}"/>
                                <TextBlock Text="{x:Static loc:Strings.Nav_Uninstaller}" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding OpenToolCommand}" CommandParameter="Updater"
                                Style="{StaticResource NavButtonStyle}" Margin="0,1,0,1"
                                Background="{Binding CurrentPage, Converter={StaticResource NavActiveBgConverter}, ConverterParameter=Updater}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{StaticResource IconUpdate}" Style="{StaticResource IconNavStyle}"/>
                                <TextBlock Grid.Column="1" Text="{x:Static loc:Strings.Nav_Updater}" FontSize="12" VerticalAlignment="Center"/>
                                <!-- v2.5.0 : % de la mise à jour en lot, visible même en changeant d'outil -->
                                <TextBlock Grid.Column="2" Text="{Binding UpdaterProgressText}" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="6,0,4,0"
                                           Visibility="{Binding IsUpdaterRunning, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </Grid>
                        </Button>

                        <Button Command="{Binding OpenToolCommand}" CommandParameter="DiskAnalyzer"
                                Style="{StaticResource NavButtonStyle}" Margin="0,1,0,1"
                                Background="{Binding CurrentPage, Converter={StaticResource NavActiveBgConverter}, ConverterParameter=DiskAnalyzer}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource IconDiskAnalyzer}" Style="{StaticResource IconNavStyle}"/>
                                <TextBlock Text="{x:Static loc:Strings.Nav_DiskAnalyzer}" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding OpenToolCommand}" CommandParameter="Startup"
                                Style="{StaticResource NavButtonStyle}" Margin="0,1,0,1"
                                Background="{Binding CurrentPage, Converter={StaticResource NavActiveBgConverter}, ConverterParameter=Startup}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource IconStartup}" Style="{StaticResource IconNavStyle}"/>
                                <TextBlock Text="{x:Static loc:Strings.Nav_Startup}" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding OpenToolCommand}" CommandParameter="Browser"
                                Style="{StaticResource NavButtonStyle}" Margin="0,1,0,1"
                                Background="{Binding CurrentPage, Converter={StaticResource NavActiveBgConverter}, ConverterParameter=Browser}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource IconBrowser}" Style="{StaticResource IconNavStyle}"/>
                                <TextBlock Text="{x:Static loc:Strings.Nav_Browser}" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding OpenToolCommand}" CommandParameter="Services"
                                Style="{StaticResource NavButtonStyle}" Margin="0,1,0,1"
                                Background="{Binding CurrentPage, Converter={StaticResource NavActiveBgConverter}, ConverterParameter=Services}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource IconServices}" Style="{StaticResource IconNavStyle}"/>
                                <TextBlock Text="{x:Static loc:Strings.Nav_Services}" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding OpenToolCommand}" CommandParameter="Restore"
                                Style="{StaticResource NavButtonStyle}" Margin="0,1,0,1"
                                Background="{Binding CurrentPage, Converter={StaticResource NavActiveBgConverter}, ConverterParameter=Restore}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource IconRestore}" Style="{StaticResource IconNavStyle}"/>
                                <TextBlock Text="{x:Static loc:Strings.Nav_Restore}" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding OpenToolCommand}" CommandParameter="Appx"
                                Style="{StaticResource NavButtonStyle}" Margin="0,1,0,1"
                                Background="{Binding CurrentPage, Converter={StaticResource NavActiveBgConverter}, ConverterParameter=Appx}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource IconAppx}" Style="{StaticResource IconNavStyle}"/>
                                <TextBlock Text="{x:Static loc:Strings.Nav_Appx}" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding OpenToolCommand}" CommandParameter="Files"
                                Style="{StaticResource NavButtonStyle}" Margin="0,1,0,1"
                                Background="{Binding CurrentPage, Converter={StaticResource NavActiveBgConverter}, ConverterParameter=Files}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource IconFiles}" Style="{StaticResource IconNavStyle}"/>
                                <TextBlock Text="{x:Static loc:Strings.Nav_Files}" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnSettings" Style="{StaticResource NavButtonStyle}"
                                Margin="0,1,0,1" Click="BtnSettings_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource IconSettings}" Style="{StaticResource IconNavStyle}"/>
                                <TextBlock Text="{x:Static loc:Strings.Nav_Settings}" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnLegal" Style="{StaticResource NavButtonStyle}"
                                Margin="0,1,0,1" Click="BtnLegal_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource IconLegal}" Style="{StaticResource IconNavStyle}"/>
                                <TextBlock Text="{x:Static loc:Strings.Nav_Legal}" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnAbout" Style="{StaticResource NavButtonStyle}"
                                Margin="0,1,0,1" Click="BtnAbout_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource IconAbout}" Style="{StaticResource IconNavStyle}"/>
                                <TextBlock Text="{x:Static loc:Strings.Nav_About}" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                    </ScrollViewer>

                    <!-- Boutons bas de sidebar -->
                    <StackPanel Grid.Row="1" Margin="10,0,10,12">
                        <Separator Background="{DynamicResource BorderBrush}" Margin="2,0,2,10" Height="1"/>

                        <Button Command="{Binding CreateRestorePointCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,0,5" Height="32" FontSize="11">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource IconShield}" Style="{StaticResource IconButtonInlineStyle}"/>
                                <TextBlock Text="{x:Static loc:Strings.Nav_RestorePoint}" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ExportLogsCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Height="32" FontSize="11">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource IconExport}" Style="{StaticResource IconButtonInlineStyle}"/>
                                <TextBlock Text="{x:Static loc:Strings.Nav_ExportLogs}" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                </Grid>
            </Border>

            <!-- ══════════════ CONTENU PRINCIPAL ══════════════ -->
            <Grid Grid.Column="1" Grid.Row="1">

                <!-- ── DASHBOARD ── -->
                <ScrollViewer Padding="24,20"
                              Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Dashboard}">
                    <StackPanel>

                        <TextBlock Text="{x:Static loc:Strings.PageTitle_Dashboard}" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,3"/>
                        <TextBlock Foreground="{DynamicResource TextTertiaryBrush}" FontSize="12" Margin="0,0,0,16">
                            <Run Text="{Binding SystemInfo.MachineName}"/>
                            <Run Text="  ·  "/>
                            <Run Text="{x:Static loc:Strings.Dashboard_UptimePrefix}"/>
                            <Run Text="{Binding SystemInfo.Uptime}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </TextBlock>

                        <!-- v2.3.0 — PERFORMANCE SCORE (jauge circulaire, style VoltAir) -->
                        <Border Style="{StaticResource OptimizationCardStyle}" Margin="0,0,0,16" Padding="20,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Jauge circulaire -->
                                <Grid Grid.Column="0" Width="128" Height="128" Margin="0,0,24,0">
                                    <!-- Anneau de fond -->
                                    <Ellipse Width="108" Height="108"
                                             Stroke="{DynamicResource BorderBrush}" StrokeThickness="9"/>
                                    <!-- Arc de progression (couleur = score) -->
                                    <Path Stroke="{Binding SystemInfo.PerformanceScoreColor}" StrokeThickness="9"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="{Binding SystemInfo.PerformanceScore, Converter={StaticResource ScoreToArcConverter}}"/>
                                    <!-- Score au centre -->
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding SystemInfo.PerformanceScoreStr}"
                                                   FontSize="40" FontWeight="Bold"
                                                   Foreground="{Binding SystemInfo.PerformanceScoreColor}"
                                                   HorizontalAlignment="Center" Margin="0,0,0,-4"/>
                                        <TextBlock Text="/100" FontSize="11"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Détails à droite -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Static loc:Strings.Dashboard_PerfScoreTitle}"
                                               FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding SystemInfo.PerformanceScoreLabel}"
                                               FontSize="22" FontWeight="Bold"
                                               Foreground="{Binding SystemInfo.PerformanceScoreColor}" Margin="0,0,0,8"/>
                                    <TextBlock Text="{x:Static loc:Strings.Dashboard_PerfScoreHint}"
                                               FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"
                                               TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Cartes stats (4 colonnes) -->
                        <UniformGrid Columns="4" Margin="0,0,0,16">

                            <!-- CPU -->
                            <Border Style="{StaticResource InteractiveCardStyle}" Margin="0,0,6,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="{StaticResource IconCpu}" Style="{StaticResource IconStatStyle}" Margin="0,0,7,0"/>
                                        <TextBlock Text="{x:Static loc:Strings.Dashboard_CardCPU}" FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <!-- v2.3.0 — Température CPU retirée : non fiable (driver ring0 WinRing0
                                         bloqué par l'Intégrité mémoire HVCI de Windows 11 → lecture 0).
                                         Le GPU (NvAPI) reste affiché. -->
                                    <TextBlock Text="{Binding SystemInfo.CpuUsageStr}"
                                               FontSize="26" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="{Binding SystemInfo.CpuName}"
                                               FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}"
                                               TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                    <!-- FIX P2-09: barre responsive (Grid star) au lieu de width fixe 140px -->
                                    <Grid Height="3" Margin="0,8,0,0">
                                        <Border CornerRadius="2" Background="{DynamicResource BorderBrush}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding SystemInfo.CpuUsage, Converter={StaticResource PercentToStarConverter}}"/>
                                                <ColumnDefinition Width="{Binding SystemInfo.CpuUsage, Converter={StaticResource PercentToStarConverter}, ConverterParameter=rest}"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" CornerRadius="2" Background="{DynamicResource AccentBrush}"/>
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- RAM -->
                            <Border Style="{StaticResource InteractiveCardStyle}" Margin="0,0,6,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="{StaticResource IconRam}" Style="{StaticResource IconStatStyle}"
                                                   Foreground="{DynamicResource SuccessBrush}" Margin="0,0,7,0"/>
                                        <TextBlock Text="{x:Static loc:Strings.Dashboard_CardRAM}" FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding SystemInfo.RamPercentStr}"
                                               FontSize="26" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                    <TextBlock Text="{Binding SystemInfo.RamInfoStr}"
                                               FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,3,0,0"/>
                                    <!-- FIX P2-09: barre responsive -->
                                    <Grid Height="3" Margin="0,8,0,0">
                                        <Border CornerRadius="2" Background="{DynamicResource BorderBrush}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding SystemInfo.RamPercent, Converter={StaticResource PercentToStarConverter}}"/>
                                                <ColumnDefinition Width="{Binding SystemInfo.RamPercent, Converter={StaticResource PercentToStarConverter}, ConverterParameter=rest}"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" CornerRadius="2" Background="{DynamicResource SuccessBrush}"/>
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Disque -->
                            <Border Style="{StaticResource InteractiveCardStyle}" Margin="0,0,6,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="{StaticResource IconDisk}" Style="{StaticResource IconStatStyle}"
                                                   Foreground="{DynamicResource WarningBrush}" Margin="0,0,7,0"/>
                                        <TextBlock Text="{x:Static loc:Strings.Dashboard_CardDisk}" FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding SystemInfo.DiskFreeGb}"
                                                   FontSize="26" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/>
                                        <TextBlock Text="{x:Static loc:Strings.Dashboard_DiskUnitGo}" FontSize="14" Foreground="{DynamicResource WarningBrush}"
                                                   VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding SystemInfo.DiskInfoStr}"
                                               FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,3,0,0"/>
                                    <!-- v2.3.0 — Vitesse disque live -->
                                    <TextBlock Text="{Binding SystemInfo.DiskSpeedStr}"
                                               FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Optimisations -->
                            <!-- FIX : margin bas=0 (comme les autres cartes) + stretch vertical
                                 pour que la carte SESSION ait la même hauteur que CPU/RAM/Disque. -->
                            <Border Style="{StaticResource InteractiveCardStyle}" Margin="0" VerticalAlignment="Stretch">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="{StaticResource IconSession}" Style="{StaticResource IconStatStyle}" Margin="0,0,7,0"/>
                                        <TextBlock Text="{x:Static loc:Strings.Dashboard_CardSession}" FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding OptimizationsRun}"
                                               FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{x:Static loc:Strings.Dashboard_OptimizationsRunSuffix}"
                                               FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                        </UniformGrid>

                        <!-- v2.3.0 — Carte GPU (visible si GPU détecté) -->
                        <Border Style="{StaticResource OptimizationCardStyle}" Margin="0,0,0,16"
                                Visibility="{Binding SystemInfo.HasGpu, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{StaticResource IconGpu}"
                                           Style="{StaticResource IconStatStyle}"
                                           Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Static loc:Strings.Dashboard_CardGPU}" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding SystemInfo.GpuName}"
                                               FontSize="12" Foreground="{DynamicResource TextEmphasizedBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0" HorizontalAlignment="Center">
                                    <TextBlock Text="{x:Static loc:Strings.Dashboard_GpuLoad}" FontSize="9"
                                               Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding SystemInfo.GpuLoadStr}"
                                               FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="16,0" HorizontalAlignment="Center">
                                    <TextBlock Text="{x:Static loc:Strings.Dashboard_GpuTemp}" FontSize="9"
                                               Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding SystemInfo.GpuTempStr}"
                                               FontSize="18" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Infos système + accès rapide -->
                        <Border Style="{StaticResource OptimizationCardStyle}" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{x:Static loc:Strings.Dashboard_CardSystem}" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding SystemInfo.OsName}"
                                               FontSize="12" Foreground="{DynamicResource TextEmphasizedBrush}"/>
                                </StackPanel>
                                <!-- FIX : Padding="12,0" + Height 32 pour ne plus rogner le texte
                                     verticalement (le padding vertical du style dépassait la hauteur). -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Command="{Binding NavigateCommand}" CommandParameter="Gaming"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Content="{x:Static loc:Strings.Nav_NavigateGaming}" Margin="0,0,6,0" Height="32" Padding="12,0" FontSize="12"/>
                                    <Button Command="{Binding NavigateCommand}" CommandParameter="Cleaning"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Content="{x:Static loc:Strings.Nav_NavigateCleaning}" Margin="0,0,6,0" Height="32" Padding="12,0" FontSize="12"/>
                                    <Button Command="{Binding NavigateCommand}" CommandParameter="Network"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Content="{x:Static loc:Strings.Nav_NavigateNetwork}" Margin="0,0,6,0" Height="32" Padding="12,0" FontSize="12"/>
                                    <Button Command="{Binding NavigateCommand}" CommandParameter="Streaming"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Content="{x:Static loc:Strings.Nav_NavigateStreaming}" Height="32" Padding="12,0" FontSize="12"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Activité récente -->
                        <TextBlock Text="{x:Static loc:Strings.Dashboard_RecentActivity}" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <Border Background="{DynamicResource TerminalBgBrush}" CornerRadius="6" Height="130"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <TextBox Style="{StaticResource TerminalTextStyle}"
                                     Text="{Binding TerminalOutput, Mode=OneWay}"/>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- ── MODULES (Gaming / OldPC / Cleaning / Network) ── -->
                <Grid Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Module}"
                      Margin="24,20,24,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- En-tête -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock Text="{Binding PageTitle}" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding CurrentOptimizationsCountText}"
                                   Foreground="{DynamicResource TextTertiaryBrush}" FontSize="12"/>
                    </StackPanel>

                    <!-- Toolbar -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
                        <Button Command="{Binding RunAllOptimizationsCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Height="32" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource IconPlay}" Style="{StaticResource IconButtonInlineStyle}"
                                           Foreground="{DynamicResource TextOnAccentBrush}"/>
                                <TextBlock Text="{x:Static loc:Strings.Button_RunAll}" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding StopRunAllCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Height="32" Margin="0,0,8,0"
                                Visibility="{Binding IsRunAllInProgress, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource IconStop}" Style="{StaticResource IconButtonInlineStyle}"/>
                                <TextBlock Text="{x:Static loc:Strings.Button_Stop}" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Border Background="{DynamicResource BackgroundCardBrush}" CornerRadius="5" Padding="10,0"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{x:Static loc:Strings.Status_Running}" Foreground="{DynamicResource AccentBrush}"
                                       FontSize="12" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- Liste des optimisations -->
                    <ScrollViewer Grid.Row="2">
                        <ItemsControl ItemsSource="{Binding CurrentOptimizations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource OptimizationCardStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">

                                                <!-- Nom + badges -->
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,0"/>
                                                    <Border Background="{DynamicResource BadgeAdminBgBrush}" CornerRadius="3"
                                                            Padding="5,1" Margin="0,0,5,0"
                                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                            Visibility="{Binding RequiresAdmin, Converter={StaticResource AdminBadgeVisibilityConverter}}">
                                                        <TextBlock Text="{x:Static loc:Strings.Badge_Admin}" FontSize="10" Foreground="{DynamicResource BadgeAdminTextBrush}"/>
                                                    </Border>
                                                    <Border Background="{DynamicResource BadgeRebootBgBrush}" CornerRadius="3"
                                                            Padding="5,1"
                                                            Margin="0,0,5,0"
                                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                            Visibility="{Binding RequiresReboot, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock Text="{x:Static loc:Strings.Badge_Reboot}" FontSize="10" Foreground="{DynamicResource BadgeRebootTextBrush}"/>
                                                    </Border>
                                                    <Border Background="{DynamicResource BadgeSecurityBgBrush}" CornerRadius="3"
                                                            Padding="5,1"
                                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                            Visibility="{Binding IsSecurity, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock Text="{x:Static loc:Strings.Badge_Security}" FontSize="10" Foreground="{DynamicResource BadgeSecurityTextBrush}"/>
                                                    </Border>
                                                </StackPanel>

                                                <!-- Description -->
                                                <TextBlock Text="{Binding Description}"
                                                           FontSize="11" Foreground="{DynamicResource TextDescriptionBrush}"
                                                           TextWrapping="Wrap" Margin="0,0,0,5"/>

                                                <!-- Barre de progression -->
                                                <Grid Margin="0,4,0,0"
                                                      Visibility="{Binding ProgressVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="36"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- FIX P2-09: barre responsive (Grid star) -->
                                                    <Grid Grid.Column="0" Height="4" VerticalAlignment="Center">
                                                        <Border CornerRadius="2" Background="{DynamicResource BackgroundHoverBrush}"/>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="{Binding Progress, Converter={StaticResource PercentToStarConverter}}"/>
                                                                <ColumnDefinition Width="{Binding Progress, Converter={StaticResource PercentToStarConverter}, ConverterParameter=rest}"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" CornerRadius="2" Background="{DynamicResource AccentBrush}"/>
                                                        </Grid>
                                                    </Grid>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding ProgressStr}"
                                                               FontSize="10" Foreground="{DynamicResource AccentBrush}"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"
                                                               Margin="4,0,0,0"/>
                                                </Grid>

                                                <!-- Statut -->
                                                <TextBlock FontSize="11" Margin="0,3,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Terminé">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Erreur">
                                                                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="En cours…">
                                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <Run Text="● "/>
                                                    <Run Text="{Binding StatusDisplay, Mode=OneWay}"/>
                                                </TextBlock>

                                            </StackPanel>

                                            <!-- Boutons Exécuter / Annuler (v2.2.0 — cancel par item) -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                                                <!-- Exécuter (visible quand pas en cours) -->
                                                <Button Command="{Binding DataContext.RunOptimizationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Height="32" Padding="14,0"
                                                        Content="{x:Static loc:Strings.Button_Run}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <!-- Annuler (visible quand en cours) -->
                                                <Button Command="{Binding CancelCommand}"
                                                        Height="32" Padding="14,0"
                                                        Content="{x:Static loc:Strings.Button_Cancel}"
                                                        ToolTip="{x:Static loc:Strings.Button_Cancel_OptTooltip}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                            </StackPanel>

                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                </Grid>

                <!-- ── TERMINAL ── -->
                <Grid Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Terminal}"
                      Margin="24,20,24,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="{x:Static loc:Strings.PageTitle_Terminal}" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,10,0"/>
                        <Border Background="{DynamicResource StatusLiveSuccessBgBrush}" CornerRadius="4" Padding="7,2"
                                BorderBrush="{DynamicResource StatusLiveSuccessBorderBrush}" BorderThickness="1"
                                VerticalAlignment="Center">
                            <TextBlock Text="{x:Static loc:Strings.Terminal_Live}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                        </Border>
                    </StackPanel>

                    <Border Grid.Row="1" Background="{DynamicResource TerminalBgBrush}" CornerRadius="6"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <TextBox Style="{StaticResource TerminalTextStyle}"
                                 Text="{Binding TerminalOutput, Mode=OneWay}"
                                 x:Name="TerminalTextBox"/>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,10">
                        <Button Command="{Binding ClearLogsCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="{x:Static loc:Strings.Terminal_Clear}" Height="30" FontSize="12"
                                Margin="0,0,8,0"/>
                        <Button Command="{Binding ExportLogsCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Content="{x:Static loc:Strings.Terminal_ExportTxt}" Height="30" FontSize="12"/>
                    </StackPanel>

                </Grid>

                <!-- ══════════════ OUTILS INTÉGRÉS (v2.3.0) ══════════════ -->
                <views:UninstallerView
                    Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Uninstaller}"/>
                <views:UpdaterView
                    Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Updater}"/>
                <views:DiskAnalyzerView
                    Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=DiskAnalyzer}"/>
                <views:StartupManagerView
                    Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Startup}"/>
                <views:BrowserCleanerView
                    Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Browser}"/>
                <views:ServicesManagerView
                    Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Services}"/>
                <views:RestorePointManagerView
                    Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Restore}"/>
                <views:ProfilesView
                    Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Profiles}"/>
                <views:AppxManagerView
                    Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Appx}"/>
                <views:FileFinderView
                    Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Files}"/>
                <views:HealthReportView
                    Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Health}"/>

            </Grid>

            <!-- ══════════════ STATUSBAR ══════════════ -->
            <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2"
                    Background="{DynamicResource BackgroundPanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,10,10">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding StatusMessage}"
                               Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1" Margin="0,0,14,0"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center">
                        <Run Text="CPU  "/>
                        <Run Text="{Binding CpuUsageStr, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}"/>
                    </TextBlock>

                    <TextBlock Grid.Column="2"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center">
                        <Run Text="RAM  "/>
                        <Run Text="{Binding SystemInfo.RamInfoStr, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </TextBlock>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
