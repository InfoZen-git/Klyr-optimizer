<UserControl x:Class="Klyr.Views.RestorePointManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Klyr.Resources">

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{x:Static loc:Strings.Restore_Title}" FontSize="20" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>

        <!-- Barre d'actions -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="BtnCreate" Content="{x:Static loc:Strings.Restore_Create}" Click="Create_Click"
                    Style="{StaticResource PrimaryButtonStyle}" Height="32" MinWidth="150" Margin="0,0,8,0"/>
            <Button x:Name="BtnOpen" Content="{x:Static loc:Strings.Restore_Open}" Click="Open_Click"
                    Style="{StaticResource SecondaryButtonStyle}" Height="32" MinWidth="170" Margin="0,0,8,0"/>
            <Button x:Name="BtnDelete" Content="{x:Static loc:Strings.Restore_DeleteAll}" Click="DeleteAll_Click"
                    Style="{StaticResource SecondaryButtonStyle}" Height="32" MinWidth="170"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2">
            <StackPanel>
                <ItemsControl x:Name="PointsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource BackgroundCardBrush}" CornerRadius="6"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    Padding="12,8" Margin="0,0,0,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Description}" FontSize="12" FontWeight="Medium"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding TypeStr}" FontSize="10"
                                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding DateStr}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="EmptyText" Text="{x:Static loc:Strings.Restore_Empty}" FontSize="12"
                           Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,40,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="3" x:Name="StatusText" VerticalAlignment="Center" Margin="0,12,0,0" FontSize="11"
                   Foreground="{DynamicResource TextTertiaryBrush}"/>
    </Grid>
</UserControl>
