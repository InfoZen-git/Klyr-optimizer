<Window x:Class="Klyr.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Klyr.Resources"
        Title="Paramètres – Klyr"
        Width="460" Height="620"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Border Background="{DynamicResource BackgroundPanelBrush}" CornerRadius="10"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="0" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="56"/>
            </Grid.RowDefinitions>

            <!-- Titlebar -->
            <Border Grid.Row="0" Background="{DynamicResource BackgroundPanelBrush}" CornerRadius="10,10,0,0"
                    MouseDown="TitleBar_MouseDown">
                <Grid Margin="16,0">
                    <TextBlock Text="{x:Static loc:Strings.Settings_Title}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <Button HorizontalAlignment="Right"
                            Width="32" Height="26" BorderThickness="0"
                            Background="Transparent" Foreground="{DynamicResource TextTertiaryBrush}"
                            Cursor="Hand" Click="Close_Click" ToolTip="{x:Static loc:Strings.Button_Close}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                    <TextBlock Text="{StaticResource IconClose}"
                                               Style="{StaticResource IconWindowControlStyle}"
                                               Foreground="{TemplateBinding Foreground}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource ErrorBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Contenu -->
            <ScrollViewer Grid.Row="1" Padding="20,16">
                <StackPanel>

                    <TextBlock Text="{x:Static loc:Strings.Settings_HeaderSecurity}" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,10"/>

                    <!-- Confirmation -->
                    <Border Background="{DynamicResource BackgroundCardBrush}" CornerRadius="7" Padding="14,12"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{x:Static loc:Strings.Settings_ConfirmBeforeRun}"
                                           FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{x:Static loc:Strings.Settings_ConfirmDesc}"
                                           FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" x:Name="ToggleConfirm"
                                      Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Restore point auto -->
                    <Border Background="{DynamicResource BackgroundCardBrush}" CornerRadius="7" Padding="14,12"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{x:Static loc:Strings.Settings_AutoRestorePoint}"
                                           FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{x:Static loc:Strings.Settings_AutoRestoreDesc}"
                                           FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" x:Name="ToggleAutoRestore"
                                      Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Reboot warning -->
                    <Border Background="{DynamicResource BackgroundCardBrush}" CornerRadius="7" Padding="14,12"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{x:Static loc:Strings.Settings_RebootWarning}"
                                           FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{x:Static loc:Strings.Settings_RebootDesc}"
                                           FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" x:Name="ToggleReboot"
                                      Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Dry-run mode -->
                    <Border Background="{DynamicResource BackgroundCardBrush}" CornerRadius="7" Padding="14,12"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{x:Static loc:Strings.Settings_Simulation}"
                                           FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{x:Static loc:Strings.Settings_SimulationDesc}"
                                           FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" x:Name="ToggleSimulation"
                                      Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Advanced tweaks -->
                    <Border Background="{DynamicResource BackgroundCardBrush}" CornerRadius="7" Padding="14,12"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{x:Static loc:Strings.Settings_ShowAdvanced}"
                                           FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{x:Static loc:Strings.Settings_AdvancedDesc}"
                                           FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" x:Name="ToggleAdvanced"
                                      Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Benchmark mode -->
                    <Border Background="{DynamicResource BackgroundCardBrush}" CornerRadius="7" Padding="14,12"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{x:Static loc:Strings.Settings_Benchmarks}"
                                           FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{x:Static loc:Strings.Settings_BenchmarksDesc}"
                                           FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" x:Name="ToggleBenchmarks"
                                      Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="{x:Static loc:Strings.Settings_HeaderInterface}" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,10"/>

                    <!-- Auto scroll -->
                    <Border Background="{DynamicResource BackgroundCardBrush}" CornerRadius="7" Padding="14,12"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{x:Static loc:Strings.Settings_AutoScrollTerminal}"
                                           FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{x:Static loc:Strings.Settings_AutoScrollDesc}"
                                           FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" x:Name="ToggleScroll"
                                      Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Badge admin -->
                    <Border Background="{DynamicResource BackgroundCardBrush}" CornerRadius="7" Padding="14,12"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{x:Static loc:Strings.Settings_ShowAdminBadge}"
                                           FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{x:Static loc:Strings.Settings_AdminBadgeDesc}"
                                           FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" x:Name="ToggleAdminBadge"
                                      Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- v2.3.0 (sécurité) — Capteurs matériels (driver kernel) -->
                    <Border Background="{DynamicResource BackgroundCardBrush}" CornerRadius="7" Padding="14,12"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{x:Static loc:Strings.Settings_HwSensors}"
                                           FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{x:Static loc:Strings.Settings_HwSensorsDesc}"
                                           FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" x:Name="ToggleHwSensors"
                                      Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- v2.3.0 — Vérification des mises à jour -->
                    <Border Background="{DynamicResource BackgroundCardBrush}" CornerRadius="7" Padding="14,12"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{x:Static loc:Strings.Settings_UpdateCheck}"
                                           FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{x:Static loc:Strings.Settings_UpdateCheckDesc}"
                                           FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" x:Name="ToggleUpdateCheck"
                                      Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Theme -->
                    <Border Background="{DynamicResource BackgroundCardBrush}" CornerRadius="7" Padding="14,12"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{x:Static loc:Strings.Settings_LightTheme}"
                                           FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{x:Static loc:Strings.Settings_LightThemeDesc}"
                                           FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" x:Name="ToggleLightTheme"
                                      Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- v2.2.0 — Sélecteur de langue -->
                    <TextBlock Text="{x:Static loc:Strings.Settings_HeaderLanguage}" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,10"/>

                    <Border Background="{DynamicResource BackgroundCardBrush}" CornerRadius="7" Padding="14,12"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{x:Static loc:Strings.Settings_Language}"
                                       FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{x:Static loc:Strings.Settings_LanguageRestartHint}"
                                       FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,10" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="LangAuto" GroupName="Language" Margin="0,0,18,0"
                                             Content="{x:Static loc:Strings.Settings_Language_Auto}"
                                             Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <RadioButton x:Name="LangFr" GroupName="Language" Margin="0,0,18,0"
                                             Content="{x:Static loc:Strings.Settings_Language_FR}"
                                             Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <RadioButton x:Name="LangEn" GroupName="Language"
                                             Content="{x:Static loc:Strings.Settings_Language_EN}"
                                             Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- v2.3.0 — Scans programmés -->
                    <TextBlock Text="{x:Static loc:Strings.Settings_HeaderSchedule}" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,18,0,10"/>

                    <Border Background="{DynamicResource BackgroundCardBrush}" CornerRadius="7" Padding="14,12"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{x:Static loc:Strings.Settings_ScheduleEnable}"
                                               FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{x:Static loc:Strings.Settings_ScheduleDesc}"
                                               FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" x:Name="ToggleSchedule"
                                          Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                          Click="ToggleSchedule_Click"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0" x:Name="FreqPanel">
                                <RadioButton x:Name="FreqDaily" GroupName="Freq" Margin="0,0,18,0"
                                             Content="{x:Static loc:Strings.Settings_ScheduleDaily}"
                                             Foreground="{DynamicResource TextPrimaryBrush}" Checked="Freq_Checked"/>
                                <RadioButton x:Name="FreqWeekly" GroupName="Freq" Margin="0,0,18,0" IsChecked="True"
                                             Content="{x:Static loc:Strings.Settings_ScheduleWeekly}"
                                             Foreground="{DynamicResource TextPrimaryBrush}" Checked="Freq_Checked"/>
                                <RadioButton x:Name="FreqMonthly" GroupName="Freq"
                                             Content="{x:Static loc:Strings.Settings_ScheduleMonthly}"
                                             Foreground="{DynamicResource TextPrimaryBrush}" Checked="Freq_Checked"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Background="{DynamicResource BackgroundFooterBrush}" CornerRadius="0,0,10,10"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,16,0">
                    <Button Content="{x:Static loc:Strings.Button_Cancel}" Click="Cancel_Click"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,0" Height="32" Width="88"/>
                    <Button Content="{x:Static loc:Strings.Button_Save}" Click="Save_Click"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="32" Width="108"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
