<UserControl x:Class="Klyr.Views.StartupManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Klyr.Resources">

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{x:Static loc:Strings.Startup_Title}" FontSize="20" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>

        <ScrollViewer Grid.Row="1">
            <ItemsControl x:Name="EntriesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource BackgroundCardBrush}" CornerRadius="6"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                Padding="12,8" Margin="0,0,0,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Medium"
                                               Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Command}" FontSize="10"
                                               Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding SourceStr}" FontSize="9"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,1,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding StatusStr}" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{Binding StatusColor}" VerticalAlignment="Center" Margin="8,0,12,0"/>
                                <CheckBox Grid.Column="2" IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                          Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                          Click="Toggle_Click" Tag="{Binding}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="1" x:Name="OverlayPanel" Background="{DynamicResource BackgroundDeepBrush}" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{StaticResource IconStartup}" FontFamily="{StaticResource FluentIconsFont}"
                           FontSize="28" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="{x:Static loc:Strings.Startup_Loading}" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" x:Name="StatusText" VerticalAlignment="Center" Margin="0,12,0,0" FontSize="11"
                   Foreground="{DynamicResource TextTertiaryBrush}"/>
    </Grid>
</UserControl>
